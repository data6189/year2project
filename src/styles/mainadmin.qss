/* === (ไฟล์เดิมของคุณ) === */
QMainWindow {
    border-image: url("src/img/admin/adminbg.png") 0 0 0 0 stretch stretch;
}








#Header {
    border-bottom: 1px solid #FFD700;
}
QPushButton#navButton {
    color: #FFD700;
    border: 1px solid #FFD700;
    font-size: 16px;
    padding: 8px;
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0);
    font-weight: bold;
}
QPushButton#navButton:hover {
    background-color: #FFD700;
    color: black;
}
QPushButton#navButton:pressed {
    background-color: #DAA520;
}
#Sidebar {
    /* (คุณกำหนด max-width: 200px ในไฟล์เดิม) */
    /* (แต่ในโค้ดตั้ง setFixedWidth(260) ถ้าต้องการ 200 ให้แก้ในโค้ด) */
     max-width: 260px; /* (ปรับตามโค้ด) */
}
QPushButton#sidebarButton {
    color: white;
    border: 1px solid black;
    font-size: 16px;
    padding: 10px;
    border-radius: 5px;
    background-color: #406fb0; /* สีดำ/เทาเข้ม */
    text-align: center;
    padding-left: 20px;
    font-weight: bold;
}
QPushButton#sidebarButton:hover {
    background-color: #233755;
}

QPushButton#btn_info {
    background-color: transparent; /* พื้นหลังโปร่งใส */
    border-radius: 30px;  
}
















/* (ปุ่ม Search เดิม) */
QPushButton#searchButton {
    color: white;
    background-color: #36537b;
    border: 1px solid black;
    font-size: 16px;
    padding: 8px;
    border-radius: 5px;
    font-weight: bold;
}
QPushButton#searchButton:hover {
    background-color: #233755;
}
QScrollArea {
    border: none;
    background-color: transparent;
}
#scrollContent {
    background-color: transparent;
}
#browseLabel {
    font-size: 24px;
    font-weight: bold;
    color: #406fb0;
    padding: 10px;
}
/* (เพิ่ม) searchBox และ sortCombo (จากโค้ด) */
#searchBox {
    font-size: 16px;
    background-color: #36537b;
    padding: 5px 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
}
QComboBox#sortCombo {
    font-size: 14px;
    background-color: #406fb0;
    padding: 5px;
    border: 1px solid #000000;
    border-radius: 5px;
}

QComboBox#sortCombo QAbstractItemView {
    font-size: 14px;
    background-color: #36537b;
    padding: 5px;
    border: 1px solid #000000;
    border-radius: 5px;
}

/* (เพิ่ม) placeholder (จากโค้ด) */
#comicPlaceholder {
    border: 1px solid #ccc; 
    background-color: #36537b;
    font-size: 14px;
    color: #555;
}

















/* === (เพิ่ม) สไตล์สำหรับหน้า Profile === */

/* Label รูปโปรไฟล์ (ทำให้เป็นวงกลม) */
#profilePicLabel {
    border: 3px solid #FFD700; /* กรอบสีทอง */
    border-radius: 5px; /* (ครึ่งหนึ่งของขนาด 200px) */
    background-color: #eee;}
    /*min-width: 200px;
    min-height: 200px;
    overflow: hidden;
}

/* Label ที่แสดงชื่อหัวข้อ (Username, First Name...) */
#profileInfoFrame QLabel {
    font-size: 18px;
    font-weight: bold;
    color: #000000;
    padding-top: 5px;
}

/* ช่องแสดงข้อมูล (ReadOnly) */
QLineEdit#profileDataField, 
QTextEdit#profileDataField, 
QComboBox#profileDataField {
    background-color: white; /* <--- แก้ไขเป็นสีขาว */
    color: rgb(0, 0, 0);            /* <--- แก้ไขเป็นสีดำ */
    border: 1px solid #ccc;
    border-radius: 5px;
    padding: 8px;
    font-size: 15px;
}

QPushButton#profilesidebarButton{
    color: #ffffff;
    border: 1px solid #000000;
    font-size: 16px;
    padding: 8px;
    border-radius: 5px;
    background-color: #406fb0;
    font-weight: bold;
}

QPushButton#backsidebarButton{
    color: #ffffff;
    border: 1px solid #000000;
    font-size: 16px;
    padding: 8px;
    border-radius: 5px;
    background-color: #36537b;
    font-weight: bold;
}

QPushButton#backsidebarButton:hover {
    background-color: #FFD700;
    color: black;
}


/* ปุ่ม Edit Profile */
QPushButton#editProfileButton {
    color: rgb(0, 0, 0);
    border: 1px solid #938e8e;
    font-size: 16px;
    padding: 8px;
    border-radius: 5px;
    /*background-color: #333; /* สีดำ/เทาเข้ม */
    font-weight: bold;
}
QPushButton#editProfileButton:hover {
    background-color: #00aeff;
}

/* ปุ่ม upload profile */
QPushButton#uploadButton{
    color: rgb(0, 0, 0);
    border: 1px solid #000000;
    font-size: 16px;
    padding: 8px;
    border-radius: 5px;
    /*background-color: #333; /* สีดำ/เทาเข้ม */
    font-weight: bold;
}

QPushButton#uploadButton:hover {
    background-color: #00aeff;
}

/* ปุ่ม Confirm Profile */
QPushButton#confirmProfileButton {
    color: white; /* สีตัวอักษร */
    background-color: #28a745; /* สีเขียว (Confirm) */
    border: 1px solid #218838; /* สีขอบ */
    
    /* === (ส่วนที่ตรงกับ #navButton ตามที่คุณขอ) === */
    font-size: 16px;
    font-weight: bold;
    
    /* (ส่วนที่ทำให้ขนาดปุ่ม (padding) สอดคล้องกัน) */
    padding: 8px;
    border-radius: 5px;
}

QPushButton#confirmProfileButton:hover {
    background-color: #218838; /* เข้มขึ้นเมื่อ hover */
}

QPushButton#confirmProfileButton:pressed {
    background-color: #1e7e34; /* เข้มสุดเมื่อกด */
}











/* ----------------------------------------------------------
   2. สไตล์การ์ดรายการสินค้า (comicCard)
   ---------------------------------------------------------- */

/* สไตล์รายการ Dropdown (ที่เด้งออกมา) */
QComboBox#profileDataField QAbstractItemView {
    border: 1px solid #ccc;
    background-color: white;
    color: black;
    padding: 4px; /* ระยะห่างขอบในรายการ */
}

QPushButton#comicCard {
    background-color: #FFFFFF;
    border: 1px solid #DDDDDD;
    border-radius: 8px;
    padding: 5px;
}

QPushButton#comicCard:hover {
border: 1px solid #0078d4; /* ไฮไลท์เมื่อเมาส์ชี้ (สีน้ำเงิน) */
}

/* (แก้ไขตามคำขอ) ชื่อเรื่อง (ตัวใหญ่, สีดำ)*/
QLabel#comicName {
    font-size: 14px;
    font-weight: bold;
    color: #000000;
    padding-top: 5px;
}

/* เล่มที่ (ตัวเล็ก, สีเทาเข้ม) */
QLabel#comicVolume {
    font-size: 12px;
    color: #555555;
    padding-bottom: 5px;
}


/* ค้นหาไม่เจอ */
QLabel#noComicsLabel {
    font-size: 14px;
    font-weight: bold;
    color: #000000;
    padding-top: 5px;
}

#detailCover {
    border: 1px solid #DDDDDD;
    background-color: white;
    border-radius: 8px;
    padding: 5px; /* เว้นขอบด้านในเล็กน้อย */
}

#detailName {
    color: #1A1A1A;
    font-size: 20pt; /* ขนาดใหญ่สำหรับชื่อหลัก */
    font-weight: 700;
    padding-bottom: 5px;
    border-bottom: 2px solid #DDDDDD; /* ขีดเส้นใต้ชื่อ */
}

/* ----------------------------------------------------------
   ---------------------------------------------------------- */















/* ... (ส่วนอื่นๆ ก่อนหน้าเหมือนเดิม) ... */

/* --- Product Detail Page Styles --- */

/* ชื่อสินค้า (Read-Only) */
QTextEdit#detailNameField {
    border: none;
    background: transparent;
    font-weight: bold;
    font-size: 32px;     /* ปรับขนาดตัวอักษรตามชอบ */
    color: #000000;
    padding: 0px;
}

/* คำอธิบาย (Read-Only) */
QTextEdit#detailDescriptionField:read-only {
    background-color: white;
    border: 1px solid #CCCCCC;
    border-radius: 5px;
    padding: 10px;
    color: #000000;
    font-size: 11pt;
    line-height: 1.5; /* ระยะห่างบรรทัด */
}

/* ป้ายกำกับฟอร์ม */
QLabel#detailFormLabel {
    color: #000000;
    font-weight: bold;
    font-size: 14px; /* คุณสามารถปรับขนาดได้ตามต้องการ */
}



/* ข้อมูลฟอร์มทั่วไป (Read-Only) */
QLineEdit#detailValueField:read-only {
    border: none;
    background: transparent;
    font-size: 16px;
    color: #000000;
    padding-left: 5px;
}

QComboBox#detailValueField:read-only {
    border: none;
    background: transparent;
    font-size: 16px;
    color: #000000;
    padding-left: 5px;
}

/* ราคา (Read-Only) */
QLineEdit#detailPriceField:read-only {
    border: none;
    background: transparent;
    font-size: 16px;
    color: #000000;
    padding-left: 5px;
}

QFrame#ProductDetailPage QLineEdit:!read-only,
QFrame#ProductDetailPage QTextEdit:!read-only,
QFrame#ProductDetailPage QComboBox:enabled {
    background-color: white;       /* สีพื้นหลังเข้มขึ้นเล็กน้อยเพื่อให้ตัดกับพื้นหลังหลัก */
    color: #000000;
    border: 1px solid #007acc;       /* ขอบสีฟ้า */
    border-left: 5px solid #007acc;  /* แถบสีฟ้าด้านซ้ายเหมือนปุ่ม Sidebar */
    font-size: 14px;
}


QFrame#ProductDetailPage QComboBox QAbstractItemView {
    background-color: #ebebeb;
    border-left: 5px solid #007acc;
    color: #000000;
}

/* --- Buttons in Detail Page --- */

/* ใช้สไตล์พื้นฐานร่วมกัน */
QPushButton#editButton, QPushButton#confirmButton, 
QPushButton#cancelButton, QPushButton#deleteButton {
    background-color: #FFFFFF;
    font-size: 14px;
    color: #333333;
}

/* ปุ่ม Edit (สีฟ้า) */
QPushButton#editButton {
    background-color: #007BFF; /* สีน้ำเงินหลัก */
    color: white;
}
QPushButton#editButton:hover {
    background-color: #0056b3;
}

/* ปุ่ม Confirm (สีเขียว) */
QPushButton#confirmButton {
    background-color: #1bd045; /* สีน้ำเงินหลัก */
    color: white;
}
QPushButton#confirmButton:hover {
    background-color: #28a745;
}

/* ปุ่ม Cancel (สีเทา) */
QPushButton#cancelButton {
    background-color: #d4130d;
    color: white;
}
QPushButton#cancelButton:hover {
    background-color: #972a27;
}

/* ปุ่ม Delete (สีแดง) */
QPushButton#deleteButton {
    background-color: #d4130d;
    color: white;
}
QPushButton#deleteButton:hover {
    background-color: #972a27;
}

/* ปุ่มเปลี่ยนรูป */
QPushButton#detailUploadButton {
    background: transparent;
    border: 1px solid #000000;
    color: rgb(0, 0, 0);
    border-radius: 5px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#detailUploadButton:hover {
    border: 1px solid #000000;
    background-color: #007BFF;
    color: white;
}
















/*CART*/
/* --- Cart Table --- */
#cartTable {
    background-color: transparent;
    border: 2px solid #000000; /* เส้นขอบตารางสีเข้ม */
    font-family: "Mitr", sans-serif; /* หรือฟอนต์ที่คุณใช้ */
    font-size: 16px;
    color: #000000;
}

/* Header ของตาราง */
#cartTable QHeaderView::section {
    background-color: #406fb0; /* สีพื้นหลัง Header อ่อนกว่านิดหน่อย */
    color: #ffffff;
    padding: 8px;
    border: 1px solid #000000;
    font-weight: bold;
    font-size: 14px;
    text-transform: uppercase; /* ตัวพิมพ์ใหญ่ทั้งหมด */
}

/* --- Items in Table --- */
/* ชื่อสินค้าในตาราง */
#cartItemName {
    font-weight: bold;
    font-size: 16px;
    color: #333333;
    padding-left: 10px;
}

/* QSpinBox สำหรับจำนวน */
/* QSpinBox ในตารางตะกร้า */
/* ปรับแต่ง QSpinBox ในหน้าตะกร้า */
QSpinBox {
    font-size: 16px;
    font-weight: bold;
    color: #000000; /* สีตัวเลขด้านใน */
    background-color: #FFFFFF; /* พื้นหลังกล่อง */
    border: 1px solid #CCCCCC; /* สีกรอบ */
    border-radius: 5px;
    padding: 5px; /* ระยะห่างภายใน */
}

/* ปุ่มขึ้น */
QSpinBox::up-button {
    width: 20px; /* ความกว้างของปุ่ม */
    height: 16px; /* ความสูง (ประมาณครึ่งหนึ่ง) */
    border-bottom: 1px solid #c0c0c0; /* เส้นแบ่งตรงกลาง */
    border-left: 1px solid #c0c0c0;   /* เส้นแบ่งด้านซ้าย */
    border-top-right-radius: 4px;     /* ทำให้มุมบนขวาโค้งมน */
}

QSpinBox::up-arrow {
    image: url(src/img/icon/up.png); /* (ตัวอย่าง) ต้องมีไฟล์นี้ */
    width: 10px;
    height: 10px;
}

/* ปุ่มลง */
QSpinBox::down-button {
    width: 20px; /* ความกว้างของปุ่ม */
    height: 16px; /* ความสูง (ประมาณครึ่งหนึ่ง) */
    border-left: 1px solid #c0c0c0;
    border-top: 1px solid #c0c0c0;     /* เส้นแบ่งด้านซ้าย */
    border-bottom-right-radius: 4px;  /* ทำให้มุมล่างขวาโค้งมน */
}

QSpinBox::down-arrow {
    image: url(src/img/icon/down.png); /* (ตัวอย่าง) ต้องมีไฟล์นี้ */
    width: 10px;
    height: 10px;
}

/* (Optional) Effect ตอนกด */
QSpinBox::up-button:pressed, QSpinBox::down-button:pressed {
    background-color: #E0E0E0;
}

/* ปุ่มลบ (DEL) */
#cartTable QPushButton {
    background-color: transparent;
}

#cartTable QPushButton:hover {
    background-color: #ff0000; /* พื้นหลังสีชมพูอ่อนเมื่อเอาเมาส์ชี้ */
    border-radius: 15px; /* ทำให้เป็นวงกลม (ถ้าปุ่มขนาด 30x30) */
}

/* --- Cart Summary (Footer) --- */
#cartSummaryLabel {
    font-size: 18px;
    color: black;
    font-weight: normal;
}

#cartSummaryValue {
    font-size: 18px;
    color: black;
    font-weight: bold;
}

/* ยอดรวมสุทธิ (Total) */
#cartTotalValue {
    font-size: 28px; /* ใหญ่พิเศษ */
    color: black;
    font-weight: bold;
}

/* ปุ่ม Checkout */
#checkoutButton {
    background-color: #007BFF; /* สีน้ำเงินหลัก */
    color: white;
    font-size: 14pt;
    font-weight: 700;
    border-radius: 8px;
    padding: 10px 20px;
    min-width: 150px;
}

#checkoutButton:hover {
    background-color: #0056b3; /* สีเหลืองเมื่อเอาเมาส์ชี้ (เข้าธีมร้าน) */
}































/* --- Status Edit Section --- */

/* ComboBox เลือกสถานะ */
#statusEditCombo {
    background-color: #ffffff;
    border: 2px solid #bdc3c7;
    border-radius: 8px;
    padding: 5px 10px;
    font-size: 16px;
    color: #333;
}

#statusEditCombo:hover {
    border-color: #3498db;
}

/* *** ตรงนี้คือส่วนที่ใส่รูป *** */
#statusEditCombo::down-arrow {
    image: url("src/img/icon/up.png"); /* ใส่ path รูปของคุณตรงนี้ */
    width: 16px;  /* กำหนดขนาดรูป */
    height: 16px;
}

/* (Optional) สถานะตอนกดปุ่ม Dropdown */
#statusEditCombo::down-arrow:on {
    /* คุณอาจจะมีรูป arrow_up.png สำหรับตอนกด */
    /* image: url(src/img/icon/arrow_up.png); */
    top: 1px; /* ขยับรูปลงนิดหน่อยให้ดูเหมือนถูกกด */
    left: 1px;
}
/* ปุ่ม Cancel (กากบาทสีแดง) */
#cancelStatusButton {
    background-color: #e74c3c;
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: bold;
    font-size: 20px;
}

#cancelStatusButton:hover {
    background-color: #c0392b;
}

/* ปุ่ม Edit Status หลัก */
#editStatusButton {
    background-color: #3498db;
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: bold;
    font-size: 16px;
}

#editStatusButton:hover {
    background-color: #2980b9;
}

#editStatusButton:pressed {
    background-color: #2573a7;
}

#statusEditCombo QAbstractItemView {
    background-color: #ffffff; /* สีพื้นหลังรายการเป็นสีขาว */
    border: 1px solid #bdc3c7; /* ขอบของ Dropdown list */
    color: #000000;
    outline: none; /* ลบเส้นประเวลาคลิก */
}
































/* พวกหน้า your orders*/

#ordersTable {
    background-color: #233755;
    border: 2px solid #000000; /* เส้นขอบตารางสีเข้ม */
    font-family: "Mitr", sans-serif; /* หรือฟอนต์ที่คุณใช้ */
    font-size: 16px;
    color: white;
}

#ordersTable QHeaderView::section {
    background-color: #406fb0; /* สีพื้นหลัง Header อ่อนกว่านิดหน่อย */
    color: #ffffff;
    padding: 8px;
    border: 1px solid #000000;
    font-weight: bold;
    font-size: 14px;
    text-transform: uppercase; /* ตัวพิมพ์ใหญ่ทั้งหมด */
}

/* --- Orders History Table (หน้าประวัติการสั่งซื้อ) --- */
QLabel#orderDateTitle {
    font-size: 14px;
    color: #ffffff;
    margin-bottom: 5px;
}

QLabel#orderDateLabel {
    font-size: 22px;
    font-weight: bold;
    color: #ffffff;
}

QLabel#orderTimeLabel {
    font-size: 18px;
    font-weight: bold;
    color: #ffffff;
}

/* --- Order Details Page (หน้ารายละเอียดคำสั่งซื้อ) --- */
QLabel#detailsHeader {
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 10px;
    color: #406fb0;
}

/* เส้นคั่นในส่วนสรุปยอดเงิน */
QFrame#summarySeparator {
    background-color: #000000;
    max-height: 1px;
    margin: 10px 0px;
    border: none;
}

/* ปุ่ม Back และ Download */
QPushButton#ordBackButton{
    background-color: #007BFF; /* สีน้ำเงินหลัก */
    color: white;
    font-size: 14pt;
    font-weight: 700;
    border-radius: 8px;
    padding: 10px 20px;
    min-width: 150px;
}
QPushButton#ordBackButton:hover {
    background-color: #0056b3;
}

QPushButton#ordDownloadButton{
    background-color: #007BFF; /* สีน้ำเงินหลัก */
    color: white;
    font-size: 14pt;
    font-weight: 700;
    border-radius: 8px;
    padding: 10px 20px;
    min-width: 150px;
}

QPushButton#ordDownloadButton:hover{
    background-color: #0056b3;
}




/* ==========================================================================
   [PAGE] ORDER DETAILS (ADMIN)
   ========================================================================== */

/* กรอบข้อมูลลูกค้าฝั่งซ้าย */
#customerInfoFrame {
    background-color: #f9f9f9;
    border-radius: 10px;
    /* ใน QSS บางครั้ง padding ของ QFrame ต้องกำหนดผ่าน property โดยตรงในบาง Widget
       แต่ถ้าใช้ QVBoxLayout ข้างในแล้ว setContentsMargins ไว้ใน Python ก็เพียงพอ
       หรือถ้าอยากกำหนดในนี้ให้ลองใช้: */
    padding: 20px;
}

/* หัวข้อ "ที่อยู่จัดส่ง :" */
#customerInfoHeader {
    font-size: 18px;
    font-weight: bold;
    color: #333333;
    /* margin-bottom อาจไม่ส่งผลใน QLabel บาง platform ใช้การเว้นระยะใน Layout แทนจะชัวร์กว่า
       แต่ใส่ไว้เผื่อได้ผล */
    margin-bottom: 15px;
    font-family: 'Segoe UI', sans-serif;
}

/* ข้อความแสดงข้อมูลลูกค้า (เช่น ชื่อ, ที่อยู่) */
#customerInfoValue {
    font-size: 16px;
    color: #555555;
    font-family: 'Segoe UI', sans-serif;
}

/* เส้นคั่นในส่วนสรุปยอดเงิน */
#summarySeparatorLine {
    background-color: #000000;
    max-height: 2px;
    min-height: 2px; /* ฟิกซ์ความสูงให้แน่นอน */
    border: none;
    margin: 10px 0;
}

/* (Optional) หัวข้อ Form เช่น "Customer ID:" ถ้าอยากปรับสี */
#customerInfoLabel {
    font-size: 16px;
    font-weight: bold;
    color: #333333;
}

/* --- QScrollArea สำหรับ Order Details --- */
#orderDetailScrollArea {
    background-color: transparent;
}

/* --- (Optional) สำหรับ Content Widget ด้านใน Scroll Area หากยังเห็นสีดำแทรก --- */
#orderDetailContentWidget {
    background-color: transparent;
}
































/* ---------------------------------
--- สไตล์หน้า Add Comic Page ---
---------------------------------
*/

#addComicFormFrame QLabel {
    color: #000000; /* (สีดำ) */
    font-size: 15px; /* (ปรับขนาดตัวอักษรได้ตามชอบ) */
    font-weight: bold; /* (ทำให้เป็นตัวหนา) */
    padding-top: 5px; /* (ขยับให้ตรงกับช่องกรอก) */
}

/* (1) กรอบพรีวิวรูปภาพ */
#addComicImgPreview {
    background-color: #FFFFFF; /* (สีขาวตามที่คุณต้องการ) */
    border: 2px dashed #CCCCCC; /* (เส้นประสีเทา) */
    border-radius: 10px;
    color: #888888; /* (สีตัวอักษร "Upload Comic image") */
    font-size: 16px;
    font-weight: bold;
}

/* (2) ช่องกรอกข้อมูลทั้งหมดในหน้านี้ */
/* (เราใช้ #addComicField เพื่อไม่ให้กระทบช่องกรอกหน้า Profile) */
#addComicField {
    background-color: #FFFFFF;
    font-size: 14px;
    color: #333333;
}


#addComicField:focus {
    border: 1px solid #007BFF; /* (สีส้มเมื่อถูกคลิก) */
}

#addComicField QAbstractItemView {
    background-color: #FFFFFF; /* (พื้นหลังสีขาว) */
    color: #000000;           /* (ตัวอักษรสีดำ) */
    border: 1px solid #CCCCCC; /* (ใส่ขอบสีเทาให้ดูสวยงาม) */
}



/* (4) ปุ่ม Add Product (ปุ่มหลักสีเหลือง/ส้ม) */
#addProductButton {
    background-color: #007BFF; /* (สีส้ม) */
    color: #FFFFFF; /* (สีขาว) */
    font-size: 16px;
    font-weight: bold;
    border: none;
    border-radius: 10px;
    padding: 10px;
}

#addProductButton:hover {
    background-color: #0056b3; /* (สีเหลืองสว่าง) */
    color: #333333;
}